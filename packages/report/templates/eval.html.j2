<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Eval {{ report.config_id }} — pass rate {{ pass_rate }}</title>
<style>
  :root{
    --bg:#0b0f14; --panel:#11161d; --panel2:#161d26; --ink:#e8edf3; --ink2:#c3ccd6;
    --muted:#8794a3; --rule:#2a333f; --accent:#ffb454; --accent2:#4f9dff; --ok:#5bd6a2; --bad:#ff7b7b;
    --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
    --sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{overflow-x:clip}
  body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 var(--sans);padding:32px}
  .wrap{max-width:980px;margin:0 auto}
  h1{font-size:24px;line-height:1.15;margin:0 0 6px}
  h2{font-size:16px;margin:28px 0 12px}
  .meta{color:var(--muted);font-size:14px;margin:0 0 20px}
  .kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:10px;overflow:hidden;margin:0 0 24px}
  .kpis>div{background:var(--panel);padding:12px 14px}
  .kpis .v{font-family:var(--mono);font-size:15px;color:var(--ink)}
  .kpis .l{font-size:11px;color:var(--muted)}
  table{width:100%;border-collapse:collapse;background:var(--panel);border:1px solid var(--rule);border-radius:10px;overflow:hidden;font-size:14px}
  th{background:var(--panel2);text-align:left;padding:8px 12px;font-size:11px;color:var(--muted);font-weight:600}
  td{padding:8px 12px;border-top:1px solid var(--rule);vertical-align:top}
  td.num{font-family:var(--mono);text-align:right;white-space:nowrap}
  .row.regressed{background:color-mix(in srgb,var(--bad) 9%,transparent)}
  .row.improved{background:color-mix(in srgb,var(--ok) 7%,transparent)}
  .res{font-family:var(--mono);font-size:12px;font-weight:700}
  .res.PASS{color:var(--ok)} .res.FAIL{color:var(--bad)}
  .callout{border:1px solid var(--rule);border-left:3px solid var(--bad);border-radius:10px;background:color-mix(in srgb,var(--bad) 8%,transparent);padding:12px 16px;margin:12px 0}
  .callout.good{border-left-color:var(--ok);background:color-mix(in srgb,var(--ok) 7%,transparent)}
  .callout h3{margin:0 0 8px;font-size:13px}
  .callout li{font-size:13px;margin:3px 0}
  figure.ch{margin:14px 0}
  figure.ch img{max-width:100%;border:1px solid var(--rule);border-radius:8px;display:block}
  figure.ch figcaption{font-family:var(--mono);font-size:11px;color:var(--muted);margin-top:4px}
  details{margin-top:24px;background:var(--panel);border:1px solid var(--rule);border-radius:10px;padding:12px 16px}
  details summary{cursor:pointer;font-size:13px;color:var(--ink2)}
  details pre{background:var(--panel2);border:1px solid var(--rule);border-radius:8px;padding:10px 12px;overflow:auto;max-height:420px;font-family:var(--mono);font-size:12px;color:var(--ink2);white-space:pre-wrap}
  footer{margin-top:32px;padding-top:12px;border-top:1px solid var(--rule);font-family:var(--mono);font-size:11px;color:var(--muted)}
  @media(max-width:560px){.kpis{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div class="wrap">
  <h1>Evaluation — {{ report.config_id }}</h1>
  <div class="meta">{{ report.model }} ({{ report.provider }}) · prompt v{{ report.prompt_version }} · dataset v{{ report.dataset_version }} · hash <code>{{ report.config_hash }}</code></div>
  <div class="kpis">
    <div><div class="v">{{ pass_rate }}</div><div class="l">pass rate</div></div>
    <div><div class="v">{{ avg_cost }}</div><div class="l">avg cost</div></div>
    <div><div class="v">{{ avg_latency }}</div><div class="l">avg latency</div></div>
    <div><div class="v">{{ p50 }}</div><div class="l">p50</div></div>
    <div><div class="v">{{ p95 }}</div><div class="l">p95</div></div>
  </div>

  {% if baseline %}
  <div class="callout">
    <h3>vs baseline {{ baseline.config_id }}</h3>
    <p style="margin:0;font-size:13px;color:var(--ink2)">pass rate {{ pass_rate }} (baseline {{ baseline_pass_rate }}) · avg cost {{ avg_cost }} (baseline {{ baseline_avg_cost }})</p>
  </div>
  {% endif %}

  {% if regressions %}
  <div class="callout">
    <h3>Regressions — PASS → FAIL</h3>
    <ul style="margin:0;padding-left:18px">
      {% for t in regressions %}<li><code>{{ t.task }}</code> — {{ t.scorer }}{% if t.detail %}: {{ t.detail }}{% endif %}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}
  {% if improvements %}
  <div class="callout good">
    <h3>Improvements — FAIL → PASS</h3>
    <ul style="margin:0;padding-left:18px">
      {% for t in improvements %}<li><code>{{ t.task }}</code> — {{ t.scorer }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  <h2>Per task</h2>
  <table>
    <thead><tr><th>task</th><th>scorer</th><th>result</th><th>score</th><th>cost</th><th>latency</th></tr></thead>
    <tbody>
    {% for row in rows %}
      <tr class="row{% if row.regressed %} regressed{% elif row.improved %} improved{% endif %}">
        <td>{{ row.task }}</td>
        <td>{{ row.scorer }}</td>
        <td><span class="res {{ row.result }}">{{ row.result }}</span></td>
        <td class="num">{{ "%.2f"|format(row.score) }}</td>
        <td class="num">{{ row.cost }}</td>
        <td class="num">{{ row.latency }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Charts</h2>
  {% for c in charts %}
    {% if c.data_url %}
    <figure class="ch"><img src="{{ c.data_url }}" alt="{{ c.label }}"><figcaption>{{ c.label }}</figcaption></figure>
    {% endif %}
  {% endfor %}

  <details>
    <summary>Appendix — full per-task JSON</summary>
    <pre>{{ full_json }}</pre>
  </details>

  <footer>config hash {{ report.config_hash }} · report {{ gen_version }} · {{ timestamp }}</footer>
</div>
</body>
</html>
